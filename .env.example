# =====================================================================
#  Garam Nias API (Python) – pengaturan koneksi
#  Salin file ini menjadi ".env" (di folder backend/) lalu isi nilainya.
#  - Di laptop  : dibaca otomatis saat server/skrip dijalankan
#  - Di Railway : isi nilai yang sama di menu Variables (file .env tidak ikut di-upload)
# =====================================================================

# ---- Database MongoDB Atlas ----
# Ambil dari Atlas: Clusters → Connect → Drivers. Ganti <db_username> dan <db_password>.
# Password berisi karakter @ : / ? # % harus di-encode (contoh: @ menjadi %40).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=garam-nias
# Nama database (sama dengan yang dipakai saat memasang garam_nias_demo_mobile.js)
MONGODB_DB=garam_nias

# ---- Server ----
# Kunci rahasia token login. WAJIB diganti di produksi, minimal 32 karakter acak.
# Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=ganti-dengan-kunci-acak-yang-panjang
# production = JWT_SECRET & MONGODB_URI wajib diisi
APP_ENV=development

# ---- Login lewat kode WhatsApp ----
# true  = kode masuk tampil langsung di layar HP (hanya untuk uji coba/demo)
# false = kode dikirim lewat WhatsApp (butuh FONNTE_TOKEN)
DEV_OTP=true
FONNTE_TOKEN=

# ---- Akun pemilik pertama ----
# Dibuat otomatis saat server jalan bila nomor ini belum ada di database.
# Data demo sudah berisi pemilik 081200000001, jadi biarkan seperti ini saat demo.
ADMIN_NO_HP=081200000001
ADMIN_NAMA=Pemilik
